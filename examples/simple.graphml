<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="community" for="node" attr.name="community" attr.type="string"/>
  <key id="weight" for="edge" attr.name="weight" attr.type="double"/>
  <key id="bridge" for="edge" attr.name="bridge" attr.type="boolean"/>
  <graph edgedefault="undirected">
    <node id="alice"><data key="community">east</data></node>
    <node id="bob"><data key="community">east</data></node>
    <node id="carol"><data key="community">west</data></node>
    <node id="dave"><data key="community">west</data></node>
    <edge source="alice" target="bob"><data key="weight">2.0</data></edge>
    <edge source="carol" target="dave"><data key="weight">2.0</data></edge>
    <edge source="bob" target="carol">
      <data key="weight">1.0</data>
      <data key="bridge">true</data>
    </edge>
  </graph>
</graphml>
