# Local Ollama. Uncomment this block to use the model on this machine.
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=phi4-mini

# Groq (free, cloud). Create a key at https://console.groq.com
# Uncomment this block instead of the Ollama block.
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=
